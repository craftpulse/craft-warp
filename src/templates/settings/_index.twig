{% extends '_layouts/cp' %}
{% import '_includes/forms.twig' as forms %}

{% set selectedSubnavItem = 'settings' %}
{% set fullPageForm = not readOnly %}

{% set allowPublicRegistration = craft.app.projectConfig.get('users.allowPublicRegistration') %}

{% set groupOptions = [{ value: '', label: 'Craft’s default user group'|t('warp') }] %}
{% for group in craft.app.userGroups.allGroups %}
    {% set groupOptions = groupOptions|merge([{ value: group.uid, label: group.name }]) %}
{% endfor %}

{% block content %}
    {% if not readOnly %}
        {{ actionInput('warp/settings/save') }}
        {{ redirectInput('warp/settings') }}
    {% endif %}

    {% namespace 'settings' %}
        {# =================================================================
           Login methods
           ================================================================= #}
        <h2>{{ 'Login methods'|t('warp') }}</h2>

        {{ forms.checkboxSelectField({
            label: 'Enabled login methods'|t('warp'),
            instructions: 'The passwordless channels the front-end request form offers. A channel that is off is refused at issuance, so disabling one closes it end to end. At least one must stay on.'|t('warp'),
            id: 'loginMethods',
            name: 'loginMethods',
            options: [
                { value: 'magic-link', label: 'Magic link (an emailed single-use link)'|t('warp') },
                { value: 'otp', label: 'One-time code (an emailed numeric code)'|t('warp') },
            ],
            values: settings.loginMethods,
            errors: settings.getErrors('loginMethods'),
            disabled: readOnly,
        }) }}

        <hr>

        {# =================================================================
           Tokens & codes
           ================================================================= #}
        <h2>{{ 'Tokens & codes'|t('warp') }}</h2>

        {{ forms.textField({
            label: 'Sign-in link / code lifetime'|t('warp'),
            instructions: 'How long an issued magic link or one-time code stays valid, in seconds. Allowed range: 60 to 86400.'|t('warp'),
            id: 'tokenTtl',
            name: 'tokenTtl',
            type: 'number',
            value: settings.tokenTtl,
            errors: settings.getErrors('tokenTtl'),
            disabled: readOnly,
            inputAttributes: { inputmode: 'numeric', min: 60, max: 86400, style: 'width: 7rem' },
            first: true,
        }) }}

        {{ forms.textField({
            label: 'One-time code length'|t('warp'),
            instructions: 'How many digits an issued one-time code contains. Allowed range: 4 to 10.'|t('warp'),
            id: 'otpDigits',
            name: 'otpDigits',
            type: 'number',
            value: settings.otpDigits,
            errors: settings.getErrors('otpDigits'),
            disabled: readOnly,
            inputAttributes: { inputmode: 'numeric', min: 4, max: 10, style: 'width: 7rem' },
        }) }}

        {{ forms.textField({
            label: 'One-time code attempt limit'|t('warp'),
            instructions: 'Failed entries allowed before a code is burned and the user must request a new one. Allowed range: 1 to 10.'|t('warp'),
            id: 'otpMaxAttempts',
            name: 'otpMaxAttempts',
            type: 'number',
            value: settings.otpMaxAttempts,
            errors: settings.getErrors('otpMaxAttempts'),
            disabled: readOnly,
            inputAttributes: { inputmode: 'numeric', min: 1, max: 10, style: 'width: 7rem' },
        }) }}

        {{ forms.textField({
            label: 'Issuance limit per address'|t('warp'),
            instructions: 'Maximum sign-in links or codes issued to one address per window below. Allowed range: 1 to 100.'|t('warp'),
            id: 'perEmailLimit',
            name: 'perEmailLimit',
            type: 'number',
            value: settings.perEmailLimit,
            errors: settings.getErrors('perEmailLimit'),
            disabled: readOnly,
            inputAttributes: { inputmode: 'numeric', min: 1, max: 100, style: 'width: 7rem' },
        }) }}

        {{ forms.textField({
            label: 'Issuance throttle window'|t('warp'),
            instructions: 'The per-address issuance throttle window, in seconds. Allowed range: 60 to 86400.'|t('warp'),
            id: 'perEmailWindow',
            name: 'perEmailWindow',
            type: 'number',
            value: settings.perEmailWindow,
            errors: settings.getErrors('perEmailWindow'),
            disabled: readOnly,
            inputAttributes: { inputmode: 'numeric', min: 60, max: 86400, style: 'width: 7rem' },
        }) }}

        {{ forms.textField({
            label: 'Recent-auth window'|t('warp'),
            instructions: 'How long a recent sign-in satisfies the recent-auth gate before a passwordless step-up is required for sensitive front-end actions, in seconds. Allowed range: 60 to 86400.'|t('warp'),
            id: 'recentAuthDuration',
            name: 'recentAuthDuration',
            type: 'number',
            value: settings.recentAuthDuration,
            errors: settings.getErrors('recentAuthDuration'),
            disabled: readOnly,
            inputAttributes: { inputmode: 'numeric', min: 60, max: 86400, style: 'width: 7rem' },
        }) }}

        <hr>

        {# =================================================================
           Registration
           ================================================================= #}
        <h2>{{ 'Registration'|t('warp') }}</h2>

        {% if settings.enableRegistration and not allowPublicRegistration %}
            <blockquote class="note warning">
                {{ 'Registration is enabled here, but Craft’s own “Allow public registration” setting is off, so registration stays closed. Turn it on under Settings → Users to open sign-up.'|t('warp') }}
            </blockquote>
        {% endif %}

        {{ forms.lightswitchField({
            label: 'Enable passwordless registration'|t('warp'),
            instructions: 'Offer sign-up from the unified request form. Registration also requires Craft’s own “Allow public registration” setting; when either is off the form degrades to login-only.'|t('warp'),
            id: 'enableRegistration',
            name: 'enableRegistration',
            on: settings.enableRegistration,
            errors: settings.getErrors('enableRegistration'),
            disabled: readOnly,
        }) }}

        {{ forms.selectField({
            label: 'Registration user group'|t('warp'),
            instructions: 'The group new registrants join. Leave on the default to fall back to Craft’s own default user group.'|t('warp'),
            id: 'registrationGroupUid',
            name: 'registrationGroupUid',
            options: groupOptions,
            value: settings.registrationGroupUid,
            errors: settings.getErrors('registrationGroupUid'),
            disabled: readOnly,
        }) }}

        <hr>

        {# =================================================================
           Passkeys
           ================================================================= #}
        <h2>{{ 'Passkeys'|t('warp') }}</h2>

        {{ forms.lightswitchField({
            label: 'Nudge passkey enrollment'|t('warp'),
            instructions: 'After a user signs in over an email flow while holding no passkey, prompt them once to enroll one.'|t('warp'),
            id: 'enablePasskeyNudge',
            name: 'enablePasskeyNudge',
            on: settings.enablePasskeyNudge,
            errors: settings.getErrors('enablePasskeyNudge'),
            disabled: readOnly,
        }) }}
    {% endnamespace %}
{% endblock %}
