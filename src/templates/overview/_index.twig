{% extends '_layouts/cp' %}

{% set title = 'Overview'|t('warp') %}
{% set selectedSubnavItem = 'overview' %}

{% set channelLabels = {
    'magic-link': 'Magic link'|t('warp'),
    'otp': 'One-time code'|t('warp'),
} %}

{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') %}

{% block content %}
    {# =====================================================================
       Current posture
       ===================================================================== #}
    <div class="warp-stats">
        <div class="warp-stat">
            <div class="warp-stat__label">{{ 'Registration'|t('warp') }}</div>
            <div class="warp-stat__value">
                {% if registrationEnabled %}
                    {{ 'Open'|t('warp') }}
                {% else %}
                    {{ 'Closed'|t('warp') }}
                {% endif %}
            </div>
            <div class="warp-stat__meta">
                {% if registrationEnabled %}
                    {{ 'Unknown addresses are sent a sign-up link.'|t('warp') }}
                {% else %}
                    {{ 'The request form degrades to login-only.'|t('warp') }}
                {% endif %}
            </div>
        </div>

        <div class="warp-stat">
            <div class="warp-stat__label">{{ 'Enabled login methods'|t('warp') }}</div>
            <div class="warp-stat__value">
                {% if loginMethods|length %}
                    {% for method in loginMethods %}
                        <span class="warp-badge">{{ channelLabels[method] ?? method }}</span>
                    {% endfor %}
                {% else %}
                    <span class="warp-stat__value--warning">{{ 'None'|t('warp') }}</span>
                {% endif %}
            </div>
            <div class="warp-stat__meta">
                {% if loginMethods|length %}
                    {{ 'The channels the front-end request form offers.'|t('warp') }}
                {% else %}
                    {{ 'The front-end login form has no usable path.'|t('warp') }}
                {% endif %}
            </div>
        </div>

        <div class="warp-stat">
            <div class="warp-stat__label">{{ 'Passkey adoption'|t('warp') }}</div>
            <div class="warp-stat__value">{{ passkeyUserCount|number }}</div>
            <div class="warp-stat__meta">
                {{ '{count, plural, one{member has} other{members have}} enrolled a passkey.'|t('warp', { count: passkeyUserCount }) }}
            </div>
        </div>
    </div>

    {% if enableRegistrationSetting and not allowPublicRegistration %}
        <div class="readable">
            <blockquote class="note warning">
                <p>
                    {{ 'Registration is enabled in Warp, but Craft’s own “Allow public registration” setting is off, so registration stays closed.'|t('warp') }}
                    <a href="{{ cpUrl('settings/users') }}">{{ 'Turn it on under Settings → Users'|t('warp') }}</a>
                    {{ 'to open sign-up.'|t('warp') }}
                </p>
            </blockquote>
        </div>
    {% endif %}

    <hr>

    {# =====================================================================
       Recent passwordless sign-ins
       ===================================================================== #}
    <h2>{{ 'Recent passwordless sign-ins'|t('warp') }}</h2>

    <div id="warp-overview-table"></div>

    {% css %}
        .warp-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }
        .warp-stat {
            padding: 16px 18px;
            border: 1px solid var(--hairline-color);
            border-radius: var(--large-border-radius, 8px);
            background: var(--white, #fff);
        }
        .warp-stat__label {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--medium-text-color);
            margin-bottom: 6px;
        }
        .warp-stat__value {
            font-size: 24px;
            font-weight: 600;
            line-height: 1.2;
            color: var(--text-color);
        }
        .warp-stat__value--warning { color: var(--error-color); }
        .warp-stat__meta {
            margin-top: 6px;
            font-size: 12px;
            color: var(--medium-text-color);
        }
        .warp-badge {
            display: inline-block;
            padding: 2px 8px;
            margin: 2px 4px 2px 0;
            font-size: 12px;
            font-weight: 500;
            line-height: 1.5;
            border-radius: 10px;
            background: var(--gray-100);
            color: var(--text-color);
        }
    {% endcss %}

    {% js %}
        (() => {
            const locationUnknownLabel = Craft.t('warp', 'Location unknown');
            const columns = [
                { name: '__slot:title', title: Craft.t('warp', 'User'), sortField: 'email' },
                { name: 'method', title: Craft.t('warp', 'Method'), sortField: 'method' },
                { name: 'device', title: Craft.t('warp', 'Device') },
                { name: 'ip', title: Craft.t('warp', 'IP address') },
                {
                    name: 'location',
                    title: Craft.t('warp', 'Location'),
                    callback: function(value) {
                        return value
                            ? Craft.escapeHtml(value)
                            : '<span class="warp-badge">' + locationUnknownLabel + '</span>';
                    },
                },
                { name: 'when', title: Craft.t('warp', 'When'), sortField: 'when' },
            ];

            new Craft.VueAdminTable({
                columns: columns,
                container: '#warp-overview-table',
                tableDataEndpoint: 'warp/overview/table-data',
                search: true,
                searchPlaceholder: Craft.t('warp', 'Search by email or username'),
                perPage: 20,
                emptyMessage: Craft.t('warp', 'No passwordless sign-ins recorded yet.'),
            });
        })();
    {% endjs %}
{% endblock %}
