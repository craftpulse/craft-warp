{% extends 'members/_private/layouts' %}

{# =========================================================================
   Warp example — active sessions
   =========================================================================
   Lists the devices signed in to the current account as cards and lets the
   member sign any of them out — one at a time, or "everywhere else" in a single
   step. Each card is a live Craft session joined to Warp's device registry for a
   friendly label and a device-type icon (craft.warp.sessions); the session
   making this request wears a "Current device" pill and has no sign-out button,
   since signing out here is what the normal sign-out link is for.

   Each card carries an expandable details section (native <details>/<summary>)
   with the last-active time, the IP, and — when a geo database resolved one —
   the city the session signed in from. With no geo database those location
   lines simply do not appear.

   A session created before Warp was installed (or by a path Warp does not
   capture) shows as "Unknown device" with no per-card button — it has no
   registry handle to target — but "Sign out everywhere else" still clears it.

   Posts (JSON, POST, login required) to:
     warp/sessions/revoke          -> sign out one session by its uid
     warp/sessions/revoke-others   -> sign out every session but this one

   No recent-auth gate here, deliberately: revoking a session is a defensive,
   reversible action, and a member spotting a suspicious device must be able to
   kill it at once, however old their own sign-in is. Passkey management (a
   credential change) keeps the recent-auth step-up; cleanup does not.

   Requires a signed-in user ({% requireLogin %} sends guests to the login page).
   Every control is a real <button>; async state uses live regions and moves
   focus to failures.
   ========================================================================= #}

{% requireLogin %}

{% set title = 'Active sessions'|t('warp') %}

{% block main %}
    {%- set sessions = craft.warp.sessions -%}
    {%- set otherCount = sessions|filter(s => not s.isCurrent)|length -%}

    {# Inline, currentColor device-type icons keyed by SessionInfo.deviceType. #}
    {%- set warpDeviceIcons = {
        desktop: '<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>',
        mobile: '<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg>',
        tablet: '<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M11 18h2"/></svg>',
        unknown: '<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.82 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>',
    } -%}

    <h1 class="text-2xl font-bold text-gray-900 mb-3">{{ 'Active sessions'|t('warp') }}</h1>

    <p class="text-gray-600 mb-6">
        {{ 'These are the devices currently signed in to your account. If you do not recognise one, sign it out.'|t('warp') }}
    </p>

    {# Polite status for successful, non-urgent updates. #}
    <p class="mb-4 text-sm text-green-700" id="warp-sessions-status" role="status" hidden></p>
    <p class="mb-4 text-sm text-red-700" id="warp-sessions-error" role="alert" tabindex="-1" hidden></p>

    {# --- Active sessions ----------------------------------------------------- #}
    <section class="mb-8" aria-labelledby="warp-sessions-list-heading">
        <h2 class="text-lg font-semibold text-gray-900 mb-3" id="warp-sessions-list-heading">{{ 'Signed-in devices'|t('warp') }}</h2>

        {% if sessions|length %}
            <ul class="space-y-4">
                {% for session in sessions %}
                    <li class="flex items-start bg-white border {{ session.isCurrent ? 'border-blue-300' : 'border-gray-200' }} rounded-sm p-5">
                        <span class="text-gray-400 mr-4 mt-1" aria-hidden="true">
                            {{ (warpDeviceIcons[session.deviceType] ?? warpDeviceIcons.unknown)|raw }}
                        </span>

                        <div class="flex-1">
                            <div class="flex items-center flex-wrap">
                                <span class="font-medium text-gray-900 mr-3">{{ session.deviceLabel }}</span>
                                {% if session.isCurrent %}
                                    <span class="text-xs font-semibold uppercase tracking-wide text-blue-700 bg-blue-100 rounded-full px-2 py-1">{{ 'Current device'|t('warp') }}</span>
                                {% endif %}
                            </div>

                            <details class="mt-2">
                                <summary class="text-sm text-gray-500 cursor-pointer hover:text-gray-700">{{ 'Details'|t('warp') }}</summary>
                                <dl class="mt-2 text-sm text-gray-600 space-y-1">
                                    <div class="flex">
                                        <dt class="w-28 text-gray-400">{{ 'Last active'|t('warp') }}</dt>
                                        <dd>
                                            {%- if session.lastSeen -%}
                                                {{ session.lastSeen|datetime('short') }}
                                            {%- else -%}
                                                {{ 'Unknown'|t('warp') }}
                                            {%- endif -%}
                                        </dd>
                                    </div>
                                    {% if session.ip %}
                                        <div class="flex">
                                            <dt class="w-28 text-gray-400">{{ 'IP address'|t('warp') }}</dt>
                                            <dd>{{ session.ip }}</dd>
                                        </div>
                                    {% endif %}
                                    {% if session.city %}
                                        <div class="flex">
                                            <dt class="w-28 text-gray-400">{{ 'Location'|t('warp') }}</dt>
                                            <dd>{{ session.city }}</dd>
                                        </div>
                                    {% endif %}
                                </dl>
                            </details>
                        </div>

                        <div class="ml-4">
                            {% if session.isCurrent %}
                                <span class="text-xs text-gray-400">{{ 'Use “Sign out” to end this session.'|t('warp') }}</span>
                            {% elseif session.uid %}
                                <button
                                    class="text-sm text-red-600 border border-red-200 rounded-sm px-3 py-1 cursor-pointer hover:bg-red-50 focus:outline-hidden focus:ring-3 focus:ring-blue-500"
                                    type="button"
                                    data-warp-revoke
                                    data-uid="{{ session.uid }}"
                                    data-name="{{ session.deviceLabel }}"
                                    aria-label="{{ 'Sign out {name}'|t('warp', { name: session.deviceLabel }) }}"
                                >
                                    {{ 'Sign out'|t('warp') }}
                                </button>
                            {% else %}
                                <span class="text-xs text-gray-400">{{ 'Sign out everywhere else to end this one.'|t('warp') }}</span>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-gray-500">{{ 'No other active sessions were found.'|t('warp') }}</p>
        {% endif %}
    </section>

    {# --- Sign out everywhere else -------------------------------------------- #}
    {% if otherCount > 0 %}
        <footer class="bg-white border border-gray-200 rounded-sm p-5">
            <p class="text-gray-600 mb-3">
                {{ 'Sign out of every device except this one. You will stay signed in here.'|t('warp') }}
            </p>
            <button class="bg-red-600 text-white font-medium rounded-sm px-4 py-2 cursor-pointer hover:bg-red-700 focus:outline-hidden focus:ring-3 focus:ring-blue-500" type="button" id="warp-sessions-revoke-others">
                {{ 'Sign out everywhere else'|t('warp') }}
            </button>
        </footer>
    {% endif %}

    <p class="mt-8">
        <a class="text-blue-600 hover:underline" href="{{ url('members/account') }}">{{ 'Back to your account'|t('warp') }}</a>
    </p>

    <script>
        (function () {
            var csrfToken = '{{ craft.app.request.csrfToken|e('js') }}';
            var revokeUrl = '{{ actionUrl('warp/sessions/revoke')|e('js') }}';
            var revokeOthersUrl = '{{ actionUrl('warp/sessions/revoke-others')|e('js') }}';

            var status = document.getElementById('warp-sessions-status');
            var errorNode = document.getElementById('warp-sessions-error');

            function showError(message) {
                status.hidden = true;
                errorNode.textContent = message;
                errorNode.hidden = false;
                errorNode.focus();
            }

            function post(url, body) {
                return fetch(url, {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-CSRF-Token': csrfToken
                    },
                    credentials: 'same-origin',
                    body: JSON.stringify(body || {})
                }).then(function (response) {
                    return response.json().then(function (data) {
                        return { ok: response.ok, status: response.status, data: data };
                    });
                });
            }

            // --- Sign out one session -------------------------------------------
            var revokeButtons = document.querySelectorAll('[data-warp-revoke]');
            Array.prototype.forEach.call(revokeButtons, function (button) {
                button.addEventListener('click', function () {
                    var name = button.getAttribute('data-name');
                    var confirmed = window.confirm('{{ 'Sign out'|t('warp')|e('js') }} "' + name + '"?');
                    if (!confirmed) {
                        return;
                    }

                    button.disabled = true;

                    post(revokeUrl, { uid: button.getAttribute('data-uid') }).then(function (result) {
                        if (result.ok) {
                            window.location.reload();
                            return;
                        }
                        showError((result.data && result.data.message) || '{{ 'Could not sign that session out. Please try again.'|t('warp')|e('js') }}');
                        button.disabled = false;
                    }).catch(function () {
                        showError('{{ 'Could not sign that session out. Please try again.'|t('warp')|e('js') }}');
                        button.disabled = false;
                    });
                });
            });

            // --- Sign out everywhere else ---------------------------------------
            var othersButton = document.getElementById('warp-sessions-revoke-others');
            if (othersButton) {
                othersButton.addEventListener('click', function () {
                    var confirmed = window.confirm('{{ 'Sign out of every device except this one?'|t('warp')|e('js') }}');
                    if (!confirmed) {
                        return;
                    }

                    othersButton.disabled = true;

                    post(revokeOthersUrl, {}).then(function (result) {
                        if (result.ok) {
                            window.location.reload();
                            return;
                        }
                        showError((result.data && result.data.message) || '{{ 'Could not sign your other sessions out. Please try again.'|t('warp')|e('js') }}');
                        othersButton.disabled = false;
                    }).catch(function () {
                        showError('{{ 'Could not sign your other sessions out. Please try again.'|t('warp')|e('js') }}');
                        othersButton.disabled = false;
                    });
                });
            }
        })();
    </script>
{% endblock %}
