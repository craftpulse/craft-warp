{% extends 'members/_private/layouts' %}

{# =========================================================================
   Warp example — enter your sign-in code
   =========================================================================
   Shown after the unified request form (login.twig) posts with the OTP channel.
   The visitor types the numeric code Warp emailed them and is signed in.

   The form itself is rendered by Warp's builder:

     {{ craft.warp.otpForm({ ... }).render() }}

   which outputs the whole thing: the post to warp/auth/verify-code with CSRF,
   the session-carried email prefill (or a visible email input on a direct
   visit), the segmented code input (one paste-aware square per digit, sized
   to the otpDigits setting), its hint, and the submit button. Prefer building
   your own markup? craft.warp.otpInput().render() gives you just the
   segmented input to compose into your own form.

   Reached via:  the hashed "redirect" the login form posts. Warp fixes the
   action route, not this page URL.
   ========================================================================= #}

{% set title = 'Enter your sign-in code'|t('warp') %}

{% set extraHead %}
    <meta name="robots" content="noindex">
{% endset %}

{% block main %}
    <h1 class="text-2xl font-bold text-gray-900 mb-3">{{ 'Enter your sign-in code'|t('warp') }}</h1>

    <p class="text-gray-600 mb-6">
        {{ 'We emailed you a short numeric code. Enter it below to finish signing in.'|t('warp') }}
    </p>

    {# Every class below is ours, not Warp's. Each *Attrs option merges onto
       Warp's own class rather than replacing it, so these Tailwind utilities and
       Warp's warp-otp-form__* hooks both land on the element; add
       resetClass: true to any of them to drop Warp's class entirely. boxAttrs
       and boxesAttrs reach the digit boxes the client script builds. Warp's
       stylesheet keeps its rules in a `warp` cascade layer, so un-layered CSS of
       yours always wins, and renderCss: false leaves it out altogether.

       boxAttrs spells out `border` as well as its colour on purpose: Tailwind's
       preflight zeroes border-width on every element, and a reset like that
       strips the borders Warp's own baseline gives the digit boxes. Any page
       with a reset of its own wants the same explicit width. #}
    {{ craft.warp.otpForm({
        returnUrl: url('members/account'),
        requestUrl: url('members/login'),
        attrs: { class: 'bg-white border border-gray-200 rounded-sm p-6' },
        labelAttrs: { class: 'block text-sm font-medium text-gray-700 mb-1' },
        hintAttrs: { class: 'block mt-2 text-sm text-gray-500' },
        sentAttrs: { class: 'mb-5 text-sm text-gray-600' },
        changeAttrs: { class: 'text-blue-600 hover:underline' },
        emailAttrs: { class: 'w-full border border-gray-300 rounded-sm px-3 py-2 focus:outline-hidden focus:ring-3 focus:ring-blue-500 focus:border-blue-400' },
        boxesAttrs: { class: 'gap-2' },
        boxAttrs: { class: 'border border-gray-300 rounded-sm' },
        submitAttrs: { class: 'mt-5 w-full bg-blue-600 text-white font-medium rounded-sm px-4 py-2 cursor-pointer hover:bg-blue-700 focus:outline-hidden focus:ring-3 focus:ring-blue-500' },
    }).render() }}

    <p class="mt-6 text-sm text-gray-500">
        {{ 'Did not get a code?'|t('warp') }}
        <a class="text-blue-600 hover:underline" href="{{ url('members/login') }}">{{ 'Request a new one'|t('warp') }}</a>
    </p>
{% endblock %}
