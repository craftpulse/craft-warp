{% extends 'members/_private/layouts' %}

{# =========================================================================
   Warp example — enter your sign-in code
   =========================================================================
   Shown after the unified request form (login.twig) posts with the OTP channel.
   The visitor types the numeric code Warp emailed them, together with the email
   it was sent to, and is signed in.

   Posts to:  warp/auth/verify-code   (POST, anonymous, rate-limited)

   The address the code was sent to is carried across the redirect in the
   session (the visitor's own input echoed back, so nothing is revealed), read
   back through craft.warp.requestedEmail, and submitted through a hidden
   field; the visible email input only appears as a fallback when the page is
   reached directly and the session holds no address. A ?email=... query param
   also prefills, if you build your own redirect.

   The code length below is read from Warp's otpDigits setting via
   craft.warp.otpDigits, so it tracks the setting automatically.

   Reached via:  the hashed "redirect" the login form posts. Warp fixes the
   action route, not this page URL.
   ========================================================================= #}

{% set title = 'Enter your sign-in code'|t('warp') %}

{% set extraHead %}
    <meta name="robots" content="noindex">
{% endset %}

{%- set afterSignInUrl = url('members/account') -%}
{%- set prefillEmail = craft.warp.requestedEmail ?? craft.app.request.getParam('email') ?? '' -%}
{%- set otpDigits = craft.warp.otpDigits -%}

{% block main %}
    <h1 class="text-2xl font-bold text-gray-900 mb-3">{{ 'Enter your sign-in code'|t('warp') }}</h1>

    <p class="text-gray-600 mb-6">
        {{ 'We emailed you a short numeric code. Enter it below to finish signing in.'|t('warp') }}
    </p>

    <form class="bg-white border border-gray-200 rounded p-6 space-y-5" method="post" action="{{ actionUrl('warp/auth/verify-code') }}">
        {{ csrfInput() }}
        <input type="hidden" name="returnUrl" value="{{ afterSignInUrl }}">

        {% if prefillEmail %}
            <input type="hidden" name="email" value="{{ prefillEmail }}">
            <p class="text-sm text-gray-500">
                {{ 'Your code was sent to {email}.'|t('warp', { email: prefillEmail }) }}
                <a class="text-blue-600 hover:underline" href="{{ url('members/login') }}">{{ 'Use a different address'|t('warp') }}</a>
            </p>
        {% else %}
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1" for="warp-code-email">{{ 'Email address'|t('warp') }}</label>
                <input
                    class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring focus:border-blue-400"
                    id="warp-code-email"
                    type="email"
                    name="email"
                    autocomplete="email"
                    autocapitalize="none"
                    spellcheck="false"
                    required
                >
            </div>
        {% endif %}

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1" for="warp-code">{{ 'Sign-in code'|t('warp') }}</label>
            <input
                class="w-full border border-gray-300 rounded px-3 py-2 text-lg tracking-widest focus:outline-none focus:ring focus:border-blue-400"
                id="warp-code"
                type="text"
                name="code"
                inputmode="numeric"
                autocomplete="one-time-code"
                pattern="[0-9]*"
                maxlength="{{ otpDigits }}"
                aria-describedby="warp-code-hint"
                required
                {{ prefillEmail ? 'autofocus' : '' }}
            >
            <span class="block mt-1 text-sm text-gray-500" id="warp-code-hint">{{ 'Enter the {digits}-digit code from your email.'|t('warp', { digits: otpDigits }) }}</span>
        </div>

        <button class="w-full bg-blue-600 text-white font-medium rounded px-4 py-2 hover:bg-blue-700 focus:outline-none focus:ring" type="submit">
            {{ 'Sign in'|t('warp') }}
        </button>
    </form>

    <p class="mt-6 text-sm text-gray-500">
        {{ 'Did not get a code?'|t('warp') }}
        <a class="text-blue-600 hover:underline" href="{{ url('members/login') }}">{{ 'Request a new one'|t('warp') }}</a>
    </p>
{% endblock %}
