{% extends 'members/_private/layouts' %}

{# =========================================================================
   Warp example — "check your email" confirmation
   =========================================================================
   Neutral landing page shown after the unified request form (login.twig) posts
   with the magic-link channel. Because the request endpoint is enumeration-safe,
   this page must read the same whether the address belongs to an existing
   account, a brand-new sign-up, or nothing at all — never confirm or deny that
   an account exists. The copy below covers all three cases.

   Reached via:  the hashed "redirect" the login form posts. Warp fixes the
   action route, not this page URL.
   ========================================================================= #}

{% set title = 'Check your email'|t('warp') %}

{% set extraHead %}
    <meta name="robots" content="noindex">
{% endset %}

{% block main %}
    <h1 class="text-2xl font-bold text-gray-900 mb-3">{{ 'Check your email'|t('warp') }}</h1>

    <p class="text-gray-600 mb-4">
        {{ 'If an account or a new registration matches that address, we have sent you an email with a secure sign-in link. Open it on this device and click the link to continue.'|t('warp') }}
    </p>

    {# craft.warp.tokenLifetime resolves the tokenTtl setting and formats it the
       way the email does ("15 minutes", "1 hour"), so this page and the email it
       refers to always quote the same lifetime. #}
    <p class="text-sm text-gray-500 mb-6">
        {{ 'The link expires in {duration} and can be used once. If it does not arrive within a few minutes, check your spam folder or request a new one.'|t('warp', { duration: craft.warp.tokenLifetime }) }}
    </p>

    <p>
        <a class="text-blue-600 hover:underline" href="{{ url('members/login') }}">{{ 'Back to sign in'|t('warp') }}</a>
    </p>
{% endblock %}
