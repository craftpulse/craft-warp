{# =========================================================================
   Warp example templates — top-level layout
   =========================================================================
   The shared shell every member page extends: a complete HTML document with a
   skip link, a small header nav, and the flash notices Warp's controllers set,
   so the bundle renders valid, styled pages the moment it is copied in.

   Styling is Tailwind CSS from a CDN, the same approach as Craft Commerce's
   example templates: utility classes on the markup, one stylesheet link below.
   Swap the link for your own build (or replace this layout entirely with your
   site's) when you integrate.

   The bundle assumes it lives at templates/members/ — every template path and
   URL in it starts with members/. If you rename the folder, update those
   references.

   Pages can push extra markup into <head> with:
     {% set extraHead %}<meta name="robots" content="noindex">{% endset %}

   Accessibility:
   - The skip link jumps to the focusable <main id="main-content">.
   - The error flash uses role="alert" and receives focus on load; the success
     flash uses role="status". State is never color-only.
   ========================================================================= #}

{%- set flashNotice = craft.app.session.getFlash('notice') -%}
{%- set flashError = craft.app.session.getFlash('error') -%}

<!DOCTYPE html>
<html lang="{{ craft.app.language }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>{{ (title ?? 'Members'|t('warp')) ~ ' - ' ~ siteName }}</title>

    <link href="https://unpkg.com/tailwindcss@^2/dist/tailwind.min.css" rel="stylesheet">

    {% if extraHead is defined %}
        {{ extraHead }}
    {% endif %}
</head>
<body class="min-h-screen flex flex-col bg-gray-50 text-gray-800 leading-relaxed antialiased">
    <a class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-white focus:px-3 focus:py-2 focus:rounded focus:shadow" href="#main-content">
        {{ 'Skip to content'|t('warp') }}
    </a>

    {{ include('members/_private/layouts/includes/header') }}

    <main class="flex-1 w-full max-w-xl mx-auto px-6 py-10" id="main-content" tabindex="-1">
        {% if flashError %}
            <div class="mb-6 rounded border border-red-300 bg-red-50 px-4 py-3 text-red-800" role="alert" id="warp-flash-error" tabindex="-1">
                <strong class="font-semibold">{{ 'Error'|t('warp') }}:</strong>
                {{ flashError }}
            </div>
        {% endif %}

        {% if flashNotice %}
            <div class="mb-6 rounded border border-blue-300 bg-blue-50 px-4 py-3 text-blue-800" role="status">
                <strong class="font-semibold">{{ 'Notice'|t('warp') }}:</strong>
                {{ flashNotice }}
            </div>
        {% endif %}

        {% block main %}{% endblock %}
    </main>

    <footer class="w-full max-w-xl mx-auto px-6 py-6 text-sm text-gray-400">
        {{ siteName }}
    </footer>

    {% if flashError %}
        <script>
            (function () {
                var flash = document.getElementById('warp-flash-error');
                if (flash) {
                    flash.focus();
                }
            })();
        </script>
    {% endif %}
</body>
</html>
