{% extends 'members/_private/layouts' %}

{# =========================================================================
   Warp example — sign in / sign up (unified passwordless request)
   =========================================================================
   One email field drives BOTH sign-in and sign-up: Warp resolves the address
   server-side and either emails an existing account a sign-in credential or,
   when registration is open, emails an unknown address a sign-up link. The HTTP
   response is identical either way, so this page never reveals which addresses
   are registered. The title and sign-up copy key off
   craft.warp.registrationEnabled, so a closed-registration site never promises
   an account it will not create.

   Both controls on this page are rendered by Warp's builders:

     {{ craft.warp.requestForm({ ... }).render() }}
     {{ craft.warp.passkeyButton({ ... }).render() }}

   The first outputs the post to warp/auth/request with CSRF, the labelled email
   field, the channel choice when both login methods are enabled, and the submit
   button. The second outputs the passkey button, its fallback line, its status
   live region, and the CSRF field the ceremony needs, and loads both scripts
   that ceremony runs on. Every class either one carries below is this bundle's,
   passed in through the per-element attrs options; prefer hand-writing them? The
   endpoints doc has the POST contract and the templates doc has the DOM one.

   Posts to:  warp/auth/request      (POST, anonymous, rate-limited)
   The passkey button talks to Craft core's anonymous endpoints:
              auth/passkey-request-options  +  users/login-with-passkey

   The bundle assumes it lives at templates/members/ (see the layout header).
   Point Craft's loginPath general config setting at members/login so failed
   verifications land back here with their flash.

   Accessibility:
   - Every input has an explicit <label>; the channel choice is a <fieldset> +
     <legend>; the passkey control is a real <button>.
   - Async passkey status uses live regions; failures move focus to the message.
   - No state is color-only — every notice and error carries text.
   ========================================================================= #}

{% set title = 'Sign in'|t('warp') %}

{# A ?returnUrl= sends the member back where re-auth interrupted them. Warp
   re-validates it on every path that honours it — the endpoints validate the
   posted copy, and craft.warp.passkeyButton() validates the one it hands its
   script — against the base URL of the site the request was made against. It is
   constrained HERE too, so a hostile value never reaches the page at all: only a
   site-relative path is accepted (no scheme, so a javascript: or
   protocol-relative URL can never reach the redirect), and anything else falls
   back to the account page. #}
{%- set requestedReturnUrl = craft.app.request.getParam('returnUrl') -%}
{%- set afterSignInUrl = requestedReturnUrl is not empty
    and requestedReturnUrl starts with '/'
    and not (requestedReturnUrl starts with '//')
    and '\\' not in requestedReturnUrl
    ? requestedReturnUrl
    : url('members/account') -%}

{# Whether sign-up is open (Warp's setting AND Craft's own switch). #}
{%- set registrationOpen = craft.warp.registrationEnabled -%}

{% block main %}
    <h1 class="text-2xl font-bold text-gray-900 mb-3">
        {{ registrationOpen ? 'Sign in or create an account'|t('warp') : 'Sign in'|t('warp') }}
    </h1>

    <p class="text-gray-600 mb-2">
        {{ 'Enter your email and we will send you a secure way to sign in. No password required.'|t('warp') }}
    </p>

    {% if registrationOpen %}
        <p class="text-gray-600 mb-6">
            <strong class="font-semibold text-gray-800">{{ 'New here?'|t('warp') }}</strong>
            {{ 'The same form signs you up: we will email you a link that creates your account.'|t('warp') }}
        </p>
    {% endif %}

    {% if craft.app.request.getParam('returnUrl') %}
        {# The returnUrl rides exactly one page view (a re-auth interruption).
           It is already rendered into the form above, so strip it from the
           address bar: a reload, bookmark, or later visit from this history
           entry signs in normally instead of inheriting the old destination. #}
        <script>
            if (window.history && window.history.replaceState) {
                window.history.replaceState(null, '', window.location.pathname);
            }
        </script>
    {% endif %}

    {# craft.warp.requestForm() renders the whole thing: the post to
       warp/auth/request with CSRF, the labelled email field, the channel choice
       when both methods are enabled (with its per-channel redirect swap), and
       the submit button.

       Every class below is ours, not Warp's. Each *Attrs option merges onto
       Warp's own class rather than replacing it, so these Tailwind utilities and
       Warp's warp-request-form__* hooks both land on the element; add
       resetClass: true to any of them to drop Warp's class entirely. Warp's
       stylesheet keeps its rules in a `warp` cascade layer, so un-layered CSS of
       yours always wins, and renderCss: false leaves it out altogether. #}
    {{ craft.warp.requestForm({
        linkSentUrl: 'members/link-sent',
        otpVerifyUrl: 'members/otp-verify',
        returnUrl: afterSignInUrl,
        attrs: { class: 'bg-white border border-gray-200 rounded-sm p-6 space-y-5', id: 'warp-login-form' },
        fieldAttrs: { class: 'mb-0' },
        labelAttrs: { class: 'block text-sm font-medium text-gray-700 mb-1' },
        emailAttrs: { class: 'w-full border border-gray-300 rounded-sm px-3 py-2 focus:outline-hidden focus:ring-3 focus:ring-blue-500 focus:border-blue-400' },
        channelsAttrs: { class: 'mb-0' },
        legendAttrs: { class: 'text-sm font-medium text-gray-700 mb-2' },
        choiceAttrs: { class: 'flex items-center space-x-2 mb-1' },
        submitAttrs: { class: 'w-full bg-blue-600 text-white font-medium rounded-sm px-4 py-2 cursor-pointer hover:bg-blue-700 focus:outline-hidden focus:ring-3 focus:ring-blue-500' },
    }).render() }}

    {# --- Passkey sign-in (optional, progressive enhancement). -------------

       craft.warp.passkeyButton() renders the whole section's controls: the
       button that runs the WebAuthn ceremony, the line that replaces it in a
       browser without passkey support, the live region a failure is announced
       in, and the CSRF field the two core endpoints need. Warp also loads both
       scripts the ceremony needs, so there is no <script> tag to write here.

       The heading and the divider stay ours, since they are page furniture
       rather than part of the control, and every class below is ours too: each
       *Attrs option merges onto Warp's own class rather than replacing it. #}
    <section class="mt-8 pt-6 border-t border-gray-200" aria-labelledby="warp-passkey-heading">
        <h2 class="text-lg font-semibold text-gray-900 mb-3" id="warp-passkey-heading">{{ 'Already set up a passkey?'|t('warp') }}</h2>

        {{ craft.warp.passkeyButton({
            returnUrl: afterSignInUrl,
            buttonAttrs: { class: 'w-full bg-white border border-gray-300 text-gray-800 font-medium rounded-sm px-4 py-2 cursor-pointer hover:bg-gray-100 focus:outline-hidden focus:ring-3 focus:ring-blue-500' },
            fallbackAttrs: { class: 'mt-3 text-sm text-gray-500' },
            statusAttrs: { class: 'mt-3 text-sm text-red-700' },
        }).render() }}
    </section>
{% endblock %}
